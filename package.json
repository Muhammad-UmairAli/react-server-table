{
  "name": "@umairalee/react-server-table",
  "version": "0.2.0",
  "description": "Headless React hooks for server-driven data tables — pagination, sorting, filtering, and row selection with a bring-your-own async fetcher.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "react",
    "table",
    "datatable",
    "headless",
    "hooks",
    "server-side",
    "pagination",
    "sorting",
    "filtering",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Muhammad-UmairAli/react-server-table.git"
  },
  "homepage": "https://github.com/Muhammad-UmairAli/react-server-table#readme",
  "bugs": {
    "url": "https://github.com/Muhammad-UmairAli/react-server-table/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@vitest/coverage-v8": "^2.1.8",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=18"
  }
}
